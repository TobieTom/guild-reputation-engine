{
  "name": "guild-reputation-engine",
  "version": "1.0.0",
  "description": "On-chain reputation system for Gaming Guild DAOs (YGG, Merit Circle, Avocado, etc.)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/api/server.js",
    "dev": "ts-node src/api/server.ts",
    "score": "ts-node src/index.ts score",
    "serve": "ts-node src/index.ts serve",
    "test": "echo \"Tests coming soon\" && exit 0",
    "postinstall": "npm run build"
  },
  "keywords": [
    "dao",
    "reputation",
    "gaming",
    "guild",
    "web3",
    "blockchain",
    "ygg",
    "merit-circle",
    "p2e",
    "play-to-earn"
  ],
  "author": "PineOT (Tobias)",
